# Copy to .env.local and fill in. NEVER commit the filled-in file.
# .gitignore already excludes .env and .env.* apart from this template.

# ---------------------------------------------------------------------------
# Cluster. Devnet first, always.
# ---------------------------------------------------------------------------
# devnet | testnet | mainnet-beta | localnet
#
# MAINNET CHANGES WHAT THE APP WILL SHOW, and it fails closed: any value containing
# "main" counts, because an unrecognised value would otherwise be read as devnet and a
# typo would switch the protections OFF. On mainnet:
#   - demo mode never turns on. With no DATABASE_URL the app says "record store is
#     unavailable"; it does not serve sample tasks.
#   - sample rows (demo- ids, the seed scripts' placeholder creator and signature) are
#     excluded from every list, total and lookup, and cannot be ruled on.
#   - npm run db:seed and scripts/seed-samples.mjs refuse to run.
#   - every screen carries a banner: unaudited program, and the live on-chain cap.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Leave blank to use the public endpoint for the cluster above. The public
# devnet RPC is heavily rate-limited; use a Helius/QuickNode URL for anything
# resembling a demo.
NEXT_PUBLIC_RPC_URL=

# ---------------------------------------------------------------------------
# On-chain program
# ---------------------------------------------------------------------------
# From `anchor keys sync` / the deployed program. Must match the `address` in
# the IDL - `npm run sync:idl` prints the IDL's value so you can compare.
NEXT_PUBLIC_PROGRAM_ID=

# The SPL mint bounties are denominated in.
# Devnet USDC (Circle's devnet mint): 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# DO NOT paste a mainnet mint address here while the protocol is unaudited.
NEXT_PUBLIC_USDC_MINT=

# ---------------------------------------------------------------------------
# Server-only secrets. These must never appear in a client bundle.
# Next.js only inlines NEXT_PUBLIC_* variables, and lib/server/* is guarded by
# the `server-only` package, which turns a bad import into a build error.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Which model judges.
#
# The brief specified Anthropic; Gemini was added because it has a free tier.
# Both paths are kept, so this is reversible. Leave JUDGE_PROVIDER unset to pick
# whichever key is present.
#
# What does NOT change with the provider: the system prompt, the untrusted-input
# delimiter, the shared zod schema, and every rule in applyVerdictGuards. A
# model cannot make this app approve a task whose clauses did not all pass.
# ---------------------------------------------------------------------------
# anthropic | gemini   (optional - inferred from the keys below if unset)
JUDGE_PROVIDER=gemini

# Free tier: https://aistudio.google.com/apikey
#
# This may also be set as a real environment variable instead of living here;
# Next.js does not let a blank line in .env override one that is already set in
# the environment, so both work locally. A deploy has no such environment - set
# it in the host's own settings (Vercel: Project -> Settings -> Environment
# Variables) or the judge will hold every task for manual review.
GEMINI_API_KEY=

# Which Gemini model judges. Defaults to gemini-2.5-flash.
#
# Pick a model whose FREE-TIER quota can absorb a demo, not the newest one. The
# 3.x flash models are capped at 20 requests PER DAY on the free tier, which a
# single test run exhausts - after which every verdict is correctly held for
# manual review and the app looks broken. gemini-2.5-flash has a far larger
# free allowance and answers this workload in about 1.5s.
GEMINI_MODEL=

# Hard ceiling on a single judge call, in ms. Default 45000. A verdict gates a
# payout, so it must fail rather than hang.
JUDGE_TIMEOUT_MS=

# OPTIONAL. A second Gemini model to ask when the first gives NO ANSWER: out of
# quota, too slow, down, or returning unusable output. Off unless set. Free-tier
# quotas are typically per model, so a different model usually has its own bucket.
#
# It is NEVER asked because of what the first model SAID. A low-confidence ruling,
# a rejection or a refusal is an answer and stands; asking again until something
# agrees would be judge-shopping. The fallback's ruling goes through exactly the same
# guards, and the published verdict records which model actually ruled.
#
# Pick a model you have run this prompt on. gemini-3.1-flash-lite passed the live
# suite (README, "Verified by running it"); a weaker model is allowed to be the
# fallback but is not free of risk, so check its rulings the first time it is used.
JUDGE_FALLBACK_MODEL=

# OPTIONAL. The most wall-clock time one judging run may take, in ms, retries and
# fallback included. Default 200000. The verify route is capped at 300 s and the
# judge shares that with the chain reads and the settlement, so keep this well under.
# A value that is not a positive number falls back to the default.
JUDGE_TOTAL_BUDGET_MS=

# OPTIONAL. Wallets allowed to rule on HELD tasks (human review), comma separated.
# UNSET MEANS HUMAN REVIEW IS OFF.
#
# A reviewer marks each sealed clause pass or fail with a reason; the outcome follows
# from the clauses. They sign with their wallet to prove who they are, but the VERIFIER
# key signs the on-chain verdict - so a reviewer is exactly as trusted as the verifier.
# Treat each of these wallets as a credential that can release escrow. Keep the list
# short and do not include anyone who posts or works tasks. An entry that is not a valid
# address is ignored, never guessed at. See docs/dispute-design.md.
REVIEWER_ADDRESSES=

# OPTIONAL BUT NEEDED BEFORE ANY TRACTION CLAIM. Wallets the team controls, comma separated.
# The /stats page and scripts/traction-report.ts set aside any task one of these posted or
# worked, so the headline counts only outside activity. Include every wallet you use: the
# canary wallets, the wallet that pays any make-good, anyone you pay to test.
#
# UNSET MEANS NONE ARE DECLARED, and the page and script then say the headline is NOT customer
# traction. An entry that is not a valid address stops the figures instead of being skipped,
# and is never repeated back, because the likeliest mistake is pasting a secret key here.
# Server-side only: never NEXT_PUBLIC_. A change takes effect on redeploy. See docs/launch-plan.md.
TEAM_WALLETS=

# OPTIONAL. The longest rate limit, in ms, that is waited out on the same model when
# the API itself says it will clear soon ("retry in 145ms"). Default 6000. Anything
# longer, or unstated, is treated as real quota exhaustion and not retried.
JUDGE_QUOTA_RETRY_MAX_WAIT_MS=

# The private key of the ONLY account allowed to submit verdicts on-chain.
#
# Whoever holds this can approve or reject any submitted task, which means they
# can move every escrowed bounty in the protocol. This is the MVP's single
# centralization point - see "Known limitations" in the README.
#
# Generate a dedicated key. Never reuse your personal wallet:
#   solana-keygen new --no-bip39-passphrase -o verifier.json
#   solana-keygen pubkey verifier.json      # -> pass to initialize_config
#
# Accepts base58 (what most tools print) or a JSON byte array (what
# solana-keygen writes to the file).
VERIFIER_SECRET_KEY=

# OPTIONAL. The key you are rotating TO. Leave empty except during a rotation.
#
# The app signs with whichever of the two keys the on-chain config currently
# trusts, so rotation has no window in which every verdict bounces:
#   1. set this to the new key and redeploy      (nothing changes yet)
#   2. the admin runs set_verifier_authority     (the app switches by itself)
#   3. move it into VERIFIER_SECRET_KEY, clear this, redeploy, retire the old key
# See docs/verifier-runbook.md. Same formats as above.
VERIFIER_SECRET_KEY_NEXT=

# OPTIONAL. The verifier wallet balance, in SOL, below which GET
# /api/health/verifier reports "low" (and so returns 503, which is what makes an
# uptime monitor double as the low-balance alert). Default 0.05. A value that is not
# a positive number falls back to the default rather than disabling the warning.
VERIFIER_MIN_SOL_WARN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres. Supabase's free tier is fine. Use the pooled connection string for
# serverless deploys.
DATABASE_URL=postgresql://user:password@host:5432/rubric?schema=public

# ---------------------------------------------------------------------------
# Judge
# ---------------------------------------------------------------------------
# A verdict below this confidence is NOT settled automatically; the task is held
# for a human. Raising it makes the protocol more cautious and slower.
CONFIDENCE_THRESHOLD=70
