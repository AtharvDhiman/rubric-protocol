# ---- Secrets. Nothing in here ever gets committed. ----
.env
.env.*
!.env.example
*.pem
# Solana keypairs are raw byte arrays in .json files. Never commit one.
keypair*.json
*-keypair.json
id.json
/wallets/
# The verifier secret. Whoever holds this can approve or reject any task, which
# means they can move every escrowed bounty in the protocol.
verifier.json
*verifier*.json
admin.json

# ---- Rust / Anchor ----
target/
**/*.rs.bk
.anchor/
test-ledger/
# Anchor writes the program keypair here on first build. It is a real private
# key for the program's upgrade authority path - keep it local, back it up
# yourself, do not commit it.
/target/deploy/*-keypair.json

# ---- Node ----
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-error.log*

# ---- Next.js ----
web/.next/
# ...and a stray build anywhere else. Running `next build` from the repo root
# instead of web/ drops a .next/ here full of trace files; it is never wanted.
.next/
web/out/
web/build/
web/.vercel/
web/next-env.d.ts
web/tsconfig.tsbuildinfo

# ---- Prisma ----
web/prisma/*.db
web/prisma/*.db-journal
web/prisma/migrations/dev.db*

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent worktrees. A nested checkout inside the repo: never commit it, and
# keep linters and `git add -A` from walking into a second copy of every file.
.claude/worktrees/
web/.claude/worktrees/
